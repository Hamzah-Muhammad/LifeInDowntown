/* Backpack and shop screen (docs/DESIGN.md 3M). Same palette as the menu: off-white, sodium-orange accent. */

.inv-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 5, 8, 0.72); display: none;
            flex-direction: row; justify-content: center; align-items: center; }
.inv-root--on { display: flex; }

.col { background-color: rgba(16, 17, 22, 0.94); border-radius: 18px; padding: 26px 28px; margin: 0 14px;
       border-width: 1px; border-color: rgba(255, 255, 255, 0.08); height: 820px; }
.col-backpack { width: 760px; }
.col-detail { width: 380px; }
.col-shop { width: 520px; }

.col-title { font-size: 34px; color: rgb(255, 190, 110); -unity-font-style: bold; letter-spacing: 3px; margin-bottom: 4px; }
.col-sub { font-size: 17px; color: rgba(235, 235, 230, 0.55); margin-bottom: 18px; }

/* header: cash + carried weight + body bars */
.header { flex-direction: row; justify-content: space-between; align-items: flex-end; margin-bottom: 18px; }
.cash { font-size: 30px; color: rgb(235, 235, 230); -unity-font-style: bold; }
.bars { width: 420px; }
.bar-row { flex-direction: row; align-items: center; margin: 3px 0; }
.bar-label { width: 96px; font-size: 14px; color: rgba(235, 235, 230, 0.7); letter-spacing: 2px; }
.bar { flex-grow: 1; height: 10px; border-radius: 5px; background-color: rgba(255, 255, 255, 0.1); overflow: hidden; }
.bar-fill { height: 100%; border-radius: 5px; }
.bar-value { width: 90px; font-size: 14px; color: rgb(235, 235, 230); -unity-text-align: middle-right; }
.fill-health { background-color: rgb(232, 72, 72); }
.fill-food { background-color: rgb(255, 159, 10); }
.fill-water { background-color: rgb(64, 170, 240); }
.fill-weight { background-color: rgb(200, 200, 190); }
.fill-weight--heavy { background-color: rgb(232, 72, 72); }

/* 5 x 4 slot grid */
.grid { flex-direction: row; flex-wrap: wrap; }
.slot { width: 134px; height: 118px; margin: 5px; padding: 0; border-radius: 12px; border-width: 2px;
        border-color: rgba(255, 255, 255, 0.06); background-color: rgba(255, 255, 255, 0.05); overflow: hidden; }
.slot:hover { background-color: rgba(255, 255, 255, 0.11); }
.slot--selected { border-color: rgb(255, 190, 110); }
.slot--empty { background-color: rgba(255, 255, 255, 0.025); }
.slot-strip { height: 6px; }
.slot-name { font-size: 16px; color: rgb(235, 235, 230); white-space: normal; margin: 10px 10px 0 10px; -unity-font-style: bold; }
.slot-cat { font-size: 12px; color: rgba(235, 235, 230, 0.45); margin: 2px 10px 0 10px; letter-spacing: 1px; }
.slot-count { position: absolute; right: 10px; bottom: 6px; font-size: 18px; color: rgb(235, 235, 230); -unity-font-style: bold; }
.slot-tag { position: absolute; left: 10px; bottom: 8px; font-size: 12px; color: rgb(255, 190, 110); letter-spacing: 1px; }

.cat-food { background-color: rgb(255, 159, 10); }
.cat-drink { background-color: rgb(64, 170, 240); }
.cat-medical { background-color: rgb(232, 72, 72); }
.cat-weapon { background-color: rgb(120, 128, 140); }
.cat-ammo { background-color: rgb(196, 160, 80); }
.cat-key { background-color: rgb(255, 214, 120); }
.cat-tool { background-color: rgb(150, 150, 150); }
.cat-misc { background-color: rgb(170, 120, 220); }

/* detail column */
.detail-name { font-size: 30px; color: rgb(235, 235, 230); -unity-font-style: bold; white-space: normal; }
.detail-meta { font-size: 16px; color: rgba(235, 235, 230, 0.55); margin: 6px 0 16px 0; white-space: normal; }
.detail-desc { font-size: 19px; color: rgba(235, 235, 230, 0.85); white-space: normal; margin-bottom: 18px; }
.detail-effects { font-size: 17px; color: rgb(255, 190, 110); white-space: normal; margin-bottom: 24px; }
.action { height: 54px; font-size: 20px; margin: 6px 0; border-radius: 12px; border-width: 0;
          background-color: rgba(255, 255, 255, 0.1); color: rgb(235, 235, 230); -unity-font-style: bold; }
.action:hover { background-color: rgb(255, 190, 110); color: rgb(20, 20, 24); }
.action--off { display: none; }

.toast { position: absolute; left: 28px; right: 28px; bottom: 22px; font-size: 18px; color: rgb(255, 190, 110); white-space: normal; }
.hint { position: absolute; left: 28px; bottom: 22px; font-size: 15px; color: rgba(235, 235, 230, 0.45); }

/* shop list */
.shop-list { flex-grow: 1; }
.shop-row { flex-direction: row; align-items: center; height: 58px; margin: 4px 0; padding: 0 12px; border-radius: 12px;
            background-color: rgba(255, 255, 255, 0.05); }
.shop-strip { width: 6px; height: 34px; border-radius: 3px; margin-right: 12px; }
.shop-name { flex-grow: 1; font-size: 19px; color: rgb(235, 235, 230); }
.shop-price { width: 90px; font-size: 19px; color: rgb(235, 235, 230); -unity-font-style: bold; -unity-text-align: middle-right; margin-right: 12px; }
.shop-buy { width: 86px; height: 40px; font-size: 17px; border-radius: 10px; border-width: 0;
            background-color: rgb(255, 190, 110); color: rgb(20, 20, 24); -unity-font-style: bold; }
.shop-buy:hover { background-color: rgb(255, 214, 150); }
.shop-buy--off { background-color: rgba(255, 255, 255, 0.1); color: rgba(235, 235, 230, 0.4); }
